{
    "version": 5,
    "$schema": "https://raw.githubusercontent.com/emxhive/prodex/main/schema/prodex.schema.json",
    "output": {
        "dir": ".prodex@inscribe",
        "versioned": true,
        "format": "md"
    },
    "exclude": [
        "**/node_modules/**",
        "vendor/**",
        "dist/**",
        "@shadcn/**",
        "**/components/ui/**"
    ],
    "aliases": {
        "@engine": "packages/engine/src",
        "@shared": "packages/shared/src",
        "@app": "apps/desktop/src",
        "@": "apps/desktop/src"
    },
    "depth": 10,
    "maxFiles": 200,
    "scopes": {
        "config": {
            "include": [
                "**/package.json",
                "**/tsconfig*.json",
                "**/vite.config*.ts",
                "docs/**",
                "prodex.json"
            ]
        },
        "packages": {
            "include": [
                "packages/*/src/**/*.{ts,tsx,js,jsx}"
            ]
        },
        "app": {
            "include": [
                "apps/desktop/src/**/*.{ts,tsx,js,jsx,css,scss,html}"
            ]
        }
    }
}
